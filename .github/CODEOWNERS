/infra/terraform/modules/soar/              @ahklsfg @ELSHAHALY
/infra/terraform/modules/log-archive/       @ahklsfg @ELSHAHALY

# ---------------- Shared, security-critical: either domain may approve ----------------
# The environment composition touches every domain.
/infra/terraform/environments/              @ELSHAHALY @ahklsfg
# The report-worker is S1's code but S3's forensic target.
/infra/terraform/modules/compute/worker.tf  @ELSHAHALY @ahklsfg
# The ECR push role (supply chain) and the PB-04 target service.
/infra/terraform/modules/compute/ci-push.tf  @ELSHAHALY @ahklsfg
/infra/terraform/modules/compute/service.tf  @ELSHAHALY @ahklsfg
# The API is S1's edge but carries S2's token contract.
/infra/terraform/modules/edge/api.tf        @ELSHAHALY @YasseenAbdelghany
# The CloudFront WAF holds the PB-05 IP sets.
/infra/terraform/modules/edge/waf.tf        @ELSHAHALY @ahklsfg
# The quarantine SG is what PB-01 isolates onto.
/infra/terraform/modules/network/security-groups.tf  @ELSHAHALY @ahklsfg
# The pipeline IS a security control: platform or SecOps must approve.
/.github/                                   @ELSHAHALY @ahklsfg
# Ownership rules themselves: any of the three (pair with required approvals = 2).
/.github/CODEOWNERS                         @ELSHAHALY @YasseenAbdelghany @ahklsfg
/docs/                                      @ELSHAHALY @YasseenAbdelghany @ahklsfg
/docs/adr/                                  @ELSHAHALY @YasseenAbdelghany @ahklsfg

# ---------------- Phase E: app security-critical paths ----------------
# The SOC read model and the decoy publish into S3's domain (TB5, edge bus).
/app/docs-api/src/soc/                      @YasseenAbdelghany @ahklsfg
/app/docs-api/src/decoy/                    @YasseenAbdelghany @ahklsfg
# Token verification and the production image are platform-critical.
/app/docs-api/src/auth/                     @YasseenAbdelghany @ELSHAHALY

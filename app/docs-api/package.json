{
  "name": "@cloudshield/docs-api",
  "version": "1.0.0",
  "private": true,
  "description": "CloudShield multi-tenant document API, SOC read model and GRC hub (Phase E).",
  "license": "UNLICENSED",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns int.test",
    "openapi:types": "node scripts/openapi-check.mjs --write",
    "openapi:check": "node scripts/openapi-check.mjs --check"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1152.0",
    "@aws-sdk/client-ecr": "3.1152.0",
    "@aws-sdk/client-eventbridge": "3.1152.0",
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/client-ssm": "3.1152.0",
    "@aws-sdk/lib-dynamodb": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "aws-jwt-verify": "5.2.1",
    "express": "5.3.0",
    "express-openapi-validator": "5.6.2",
    "helmet": "8.3.0",
    "jose": "5.10.0",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@aws-sdk/client-kms": "3.1152.0",
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "aws-sdk-client-mock": "4.1.0",
    "eslint": "10.13.0",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "openapi-typescript": "7.13.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}

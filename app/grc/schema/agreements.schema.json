{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudshield.local/grc/agreements.schema.json",
  "title": "Agreement catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "agreements"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "agreements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agreementId",
          "version",
          "title",
          "file",
          "effectiveDate",
          "required",
          "current"
        ],
        "properties": {
          "agreementId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,31}$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}(?:\\.\\d+)?$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "file": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}\\.txt$"
          },
          "effectiveDate": {
            "type": "string",
            "format": "date"
          },
          "required": {
            "type": "boolean"
          },
          "current": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

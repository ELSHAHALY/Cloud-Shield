{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudshield.local/grc/matrix.schema.json",
  "title": "Shared-responsibility matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "lastReviewed",
    "disclaimer",
    "providers",
    "controls",
    "layers"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{1,2}\\.\\d{1,3}$"
    },
    "lastReviewed": {
      "type": "string",
      "format": "date"
    },
    "disclaimer": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    },
    "providers": {
      "type": "array",
      "items": {
        "enum": [
          "aws",
          "azure",
          "gcp"
        ]
      },
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "control",
          "layer",
          "cells"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "control": {
            "type": "string",
            "maxLength": 200
          },
          "layer": {
            "type": "string",
            "maxLength": 64
          },
          "cells": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "aws",
              "azure",
              "gcp"
            ],
            "properties": {
              "aws": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "service",
                  "responsibility",
                  "notes",
                  "status",
                  "verify"
                ],
                "properties": {
                  "service": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "responsibility": {
                    "enum": [
                      "provider",
                      "shared",
                      "customer"
                    ]
                  },
                  "notes": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "status": {
                    "enum": [
                      "built",
                      "mapped"
                    ]
                  },
                  "verify": {
                    "type": "boolean"
                  }
                }
              },
              "azure": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "service",
                  "responsibility",
                  "notes",
                  "status",
                  "verify"
                ],
                "properties": {
                  "service": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "responsibility": {
                    "enum": [
                      "provider",
                      "shared",
                      "customer"
                    ]
                  },
                  "notes": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "status": {
                    "enum": [
                      "built",
                      "mapped"
                    ]
                  },
                  "verify": {
                    "type": "boolean"
                  }
                }
              },
              "gcp": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "service",
                  "responsibility",
                  "notes",
                  "status",
                  "verify"
                ],
                "properties": {
                  "service": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "responsibility": {
                    "enum": [
                      "provider",
                      "shared",
                      "customer"
                    ]
                  },
                  "notes": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "status": {
                    "enum": [
                      "built",
                      "mapped"
                    ]
                  },
                  "verify": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer",
          "owner",
          "notes"
        ],
        "properties": {
          "layer": {
            "type": "string",
            "maxLength": 64
          },
          "owner": {
            "type": "string",
            "maxLength": 200
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    }
  }
}

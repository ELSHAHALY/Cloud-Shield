{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudshield.local/grc/ruleset.schema.json",
  "title": "CloudShield GRC ruleset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rulesetId",
    "version",
    "lastReviewed",
    "disclaimer",
    "jurisdictions",
    "regionCountry",
    "frameworks",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "rulesetId": {
      "const": "cloudshield-grc"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{1,2}\\.\\d{1,3}$"
    },
    "lastReviewed": {
      "type": "string",
      "format": "date"
    },
    "disclaimer": {
      "type": "string",
      "minLength": 40,
      "maxLength": 2000
    },
    "jurisdictions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "frameworks"
        ],
        "properties": {
          "id": {
            "enum": [
              "EG",
              "EU",
              "SA"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 64
          },
          "frameworks": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}-[A-Z0-9-]{2,24}$"
            }
          }
        }
      }
    },
    "regionCountry": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {
        "pattern": "^[a-z]{2}(?:-[a-z]+)+-\\d$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      }
    },
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "citation",
          "regulator",
          "citationStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{2}-[A-Z0-9-]{2,24}$"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "citation": {
            "type": "string",
            "maxLength": 200
          },
          "regulator": {
            "type": "string",
            "maxLength": 200
          },
          "citationStatus": {
            "enum": [
              "doc",
              "verify"
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fact",
            "op"
          ],
          "properties": {
            "fact": {
              "enum": [
                "tenant.jurisdictions",
                "tenant.sector",
                "tenant.cbeRegulated",
                "tenant.processesPersonalData",
                "tenant.processesSensitiveData",
                "tenant.governmentData",
                "tenant.dataSubjectRegions",
                "platform.provider",
                "platform.deploymentRegions",
                "platform.deploymentCountries",
                "platform.encryptionAtRest",
                "platform.mfa",
                "platform.auditTrail",
                "platform.incidentAutomation",
                "platform.mttcTargetSeconds",
                "platform.erasureCompletesWithinDays",
                "platform.transitInternalHop",
                "platform.evidenceObjectLock",
                "platform.wafEnabled",
                "platform.malwareScanning",
                "platform.breachNotificationTooling",
                "platform.backupPitr",
                "derived.crossBorder",
                "derived.residencyCountries"
              ]
            },
            "op": {
              "enum": [
                "eq",
                "neq",
                "in",
                "includes",
                "includesAny",
                "gte",
                "lte",
                "exists"
              ]
            },
            "value": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "string",
                    "maxLength": 64
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "framework",
        "topic",
        "appliesWhen",
        "obligation",
        "citations",
        "assessment",
        "controls",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2}-[A-Z0-9-]{2,60}$"
        },
        "framework": {
          "type": "string",
          "pattern": "^[A-Z]{2}-[A-Z0-9-]{2,24}$"
        },
        "topic": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "appliesWhen": {
          "$ref": "#/$defs/condition"
        },
        "obligation": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "parameters": {
          "type": "object",
          "maxProperties": 10,
          "propertyNames": {
            "pattern": "^[a-z][A-Za-z0-9]{0,31}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "status"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "article": {
                "type": "string",
                "maxLength": 100
              },
              "status": {
                "enum": [
                  "doc",
                  "verify"
                ]
              },
              "url": {
                "type": "string",
                "maxLength": 500,
                "pattern": "^https://"
              }
            }
          }
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "platform-control",
                "customer-action",
                "residency",
                "info"
              ]
            },
            "metWhen": {
              "$ref": "#/$defs/condition"
            },
            "partialWhen": {
              "$ref": "#/$defs/condition"
            },
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "platform-control"
                  }
                }
              },
              "then": {
                "required": [
                  "metWhen"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "residency"
                  }
                }
              },
              "then": {
                "required": [
                  "country"
                ]
              }
            }
          ]
        },
        "controls": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{1,63}$"
          }
        },
        "rationale": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "MET": {
              "type": "string",
              "maxLength": 2000
            },
            "PARTIAL": {
              "type": "string",
              "maxLength": 2000
            },
            "GAP": {
              "type": "string",
              "maxLength": 2000
            },
            "CUSTOMER_ACTION": {
              "type": "string",
              "maxLength": 2000
            },
            "NOT_APPLICABLE": {
              "type": "string",
              "maxLength": 2000
            },
            "INFO": {
              "type": "string",
              "maxLength": 2000
            }
          }
        }
      }
    }
  }
}

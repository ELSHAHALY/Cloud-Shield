  "rules": [
    {
      "id": "EG-PDPL-SCOPE-CBE",
      "framework": "EG-PDPL",
      "topic": "scope",
      "appliesWhen": {
        "all": [
          {
            "fact": "tenant.jurisdictions",
            "op": "includes",
            "value": "EG"
          },
          {
            "fact": "tenant.cbeRegulated",
            "op": "eq",
            "value": true
          }
        ]
      },
      "obligation": "Personal data held by the Central Bank of Egypt and by entities under its supervision is largely excluded from the PDPL; the banking laws and CBE rules apply instead.",
      "citations": [
        {
          "source": "Egypt Personal Data Protection Law, Law No. 151 of 2020",
          "article": "Art. 3",
          "status": "verify"
        }
      ],
      "assessment": {
        "type": "info"
      },
      "controls": [],
      "rationale": {
        "INFO": "The tenant is CBE-regulated: review the CBE rules (EG-CBE) first; PDPL obligations may apply only in part.",
        "NOT_APPLICABLE": "Not CBE-regulated."
      }
    },
    {
      "id": "EG-PDPL-LAWFUL-BASIS-CONSENT",
      "framework": "EG-PDPL",
      "topic": "lawful-basis",
      "appliesWhen": {
        "all": [
          {
            "fact": "tenant.jurisdictions",
            "op": "includes",
            "value": "EG"
          },
          {
            "fact": "tenant.processesPersonalData",
            "op": "eq",
            "value": true
          }
        ]
      },
      "obligation": "Process personal data only with the data subject's consent or another basis the law allows, for a specific and legitimate purpose.",
      "citations": [
        {
          "source": "Egypt Personal Data Protection Law, Law No. 151 of 2020",
          "article": "Art. 6",
          "status": "verify"
        }
      ],
      "assessment": {
        "type": "customer-action"
      },
      "controls": [],
      "rationale": {
        "CUSTOMER_ACTION": "The lawful basis is the controller's (tenant's) decision; CloudShield processes documents on the tenant's instructions."
      }
    },
    {
      "id": "EG-PDPL-BREACH-NOTICE",
      "framework": "EG-PDPL",
      "topic": "breach-notification",
      "appliesWhen": {
        "all": [
          {
            "fact": "tenant.jurisdictions",
            "op": "includes",
            "value": "EG"
          },
          {
            "fact": "tenant.processesPersonalData",
            "op": "eq",
            "value": true
          }
        ]
      },
      "obligation": "Notify the Personal Data Protection Center of a personal data breach within 72 hours, and the affected data subjects within a short period after.",
      "parameters": {
        "deadlineHours": 72
      },
      "citations": [
        {
          "source": "Egypt Personal Data Protection Law, Law No. 151 of 2020",
          "article": "Art. 7",
          "status": "verify"
        }
      ],
      "assessment": {
        "type": "platform-control",
        "metWhen": {
          "all": [
            {
              "fact": "platform.breachNotificationTooling",
              "op": "eq",
              "value": "sns-chatops"
            },
            {
              "fact": "platform.incidentAutomation",
              "op": "eq",
              "value": "enabled"
            }
          ]
        },
        "partialWhen": {
          "fact": "platform.breachNotificationTooling",
          "op": "eq",
          "value": "sns-chatops"
        }
      },
      "controls": [
        "soar.mttc",
        "soar.ir-report",
        "chatops.notify"
      ],
      "rationale": {
        "MET": "Detection, automated containment (MTTC target 60 s), SNS/ChatOps alerting and IR reports give the evidence needed for the notice. Sending the notice to the authority remains the controller's act.",
        "PARTIAL": "Alerting and IR reports exist, but automated containment is in dry-run or disabled: incident timelines depend on analysts. Sending the notice remains the controller's act.",
        "GAP": "No breach alerting path is configured."
      }
    },
    {
      "id": "EG-PDPL-DPO",
      "framework": "EG-PDPL",
      "topic": "dpo",
      "appliesWhen": {
        "all": [
          {
            "fact": "tenant.jurisdictions",
            "op": "includes",
            "value": "EG"
          },
          {
            "fact": "tenant.processesPersonalData",
            "op": "eq",
            "value": true
          }
        ]
      },
      "obligation": "Appoint a data protection officer where the law requires it and register them with the Center.",
      "citations": [
        {
          "source": "Egypt Personal Data Protection Law, Law No. 151 of 2020",
          "article": "Art. 8–9",
          "status": "verify"
        }
      ],
      "assessment": {
        "type": "customer-action"
      },
      "controls": [],
      "rationale": {
        "CUSTOMER_ACTION": "Appointing and registering a DPO is the controller's duty."
      }
    },
    {
      "id": "EG-PDPL-CROSS-BORDER",
      "framework": "EG-PDPL",
      "topic": "cross-border",
      "appliesWhen": {
        "all": [
          {
            "fact": "tenant.jurisdictions",
            "op": "includes",
            "value": "EG"
          },
          {
            "fact": "tenant.processesPersonalData",
            "op": "eq",
            "value": true
          }
        ]
      },
      "obligation": "Transfer personal data outside Egypt only to a destination with an adequate level of protection, and with a licence or permit from the Center.",
      "citations": [
        {
          "source": "Egypt Personal Data Protection Law, Law No. 151 of 2020",
          "article": "Art. 14–15",
          "status": "verify"
        }
      ],
      "assessment": {
        "type": "platform-control",
        "metWhen": {
          "fact": "derived.crossBorder",
          "op": "eq",
          "value": false
        }
      },
      "controls": [
        "platform.region"
      ],
      "rationale": {
        "MET": "Hosted in Egypt.",
        "GAP": "Data is hosted in {deploymentRegions} ({deploymentCountries}): every request is a transfer outside Egypt. Multi-region deployment is out of the capstone scope."
      }
    },
    {
      "id": "EG-PDPL-LICENSING",
      "framework": "EG-PDPL",
      "topic": "licensing",
      "appliesWhen": {
        "all": [
          {
            "fact": "tenant.jurisdictions",
            "op": "includes",
            "value": "EG"
          },
          {
            "fact": "tenant.processesPersonalData",
            "op": "eq",
            "value": true
          }
        ]
      },
      "obligation": "Controllers and processors obtain the licence or permit the Center issues before processing.",
      "citations": [
        {
          "source": "Egypt Personal Data Protection Law, Law No. 151 of 2020",
          "article": "licensing provisions",
          "status": "verify"
        }
      ],
      "assessment": {
        "type": "customer-action"
      },
      "controls": [],
      "rationale": {
        "CUSTOMER_ACTION": "Both the tenant (controller) and the operator (processor) need the Center's licence or permit; status not tracked by CloudShield."
      }
    },
    {
      "id": "EG-PDPL-SENSITIVE-DATA",
      "framework": "EG-PDPL",
      "topic": "sensitive-data",
      "appliesWhen": {
        "all": [
          {
            "fact": "tenant.jurisdictions",
            "op": "includes",
            "value": "EG"
          },
          {
            "fact": "tenant.processesSensitiveData",
            "op": "eq",
            "value": true
          }
        ]
      },
      "obligation": "Sensitive data (including financial, health and children's data) needs explicit written consent and the Center's licence.",
      "citations": [
        {
          "source": "Egypt Personal Data Protection Law, Law No. 151 of 2020",
          "article": "sensitive data provisions",
          "status": "verify"
        }
      ],
      "assessment": {
        "type": "customer-action"
      },
      "controls": [
        "data.classification"
      ],
      "rationale": {
        "CUSTOMER_ACTION": "Classify such documents as restricted and record the explicit consent outside CloudShield."
      }
    },
    {
      "id": "EG-PDPL-EXEC-REGS",
      "framework": "EG-PDPL",
      "topic": "executive-regulations",
      "appliesWhen": {
        "fact": "tenant.jurisdictions",
        "op": "includes",
        "value": "EG"
      },
      "obligation": "Check whether the Executive Regulations are in force and when the compliance grace period ends.",
      "citations": [
        {
          "source": "Executive Regulations of Law No. 151 of 2020",
          "status": "verify"
        }
      ],
      "assessment": {
        "type": "info"
      },
      "controls": [],
      "rationale": {
        "INFO": "Status and dates are not established here: verify against the official gazette."
      }
    },
    {
      "id": "EG-PDPL-RETENTION",
      "framework": "EG-PDPL",
      "topic": "retention",
      "appliesWhen": {
        "all": [
          {
            "fact": "tenant.jurisdictions",
            "op": "includes",
            "value": "EG"
          },
          {
            "fact": "tenant.processesPersonalData",
            "op": "eq",
            "value": true
          }
        ]
      },
      "obligation": "Keep personal data no longer than the purpose requires, then erase it.",
      "citations": [
        {
          "source": "Egypt Personal Data Protection Law, Law No. 151 of 2020",
          "article": "data subject rights / retention",
          "status": "verify"
        }
      ],
      "assessment": {
        "type": "platform-control",
        "metWhen": {
          "fact": "platform.erasureCompletesWithinDays",
          "op": "lte",
          "value": 30
        }
      },
      "controls": [
        "docs.tombstone",
        "s3.noncurrent-expiry"
      ],
      "rationale": {
        "MET": "Deleting a document tombstones it at once; its S3 versions expire within 30 days. Choosing retention periods is the controller's decision.",
        "GAP": "Deleted content is not erased within 30 days."
      }
    },
    {
      "id": "EG-CBE-CLOUD-OUTSOURCING-APPROVAL",
      "framework": "EG-CBE",
      "topic": "outsourcing",
      "appliesWhen": {
        "all": [
          {
            "fact": "tenant.jurisdictions",
            "op": "includes",
            "value": "EG"
          },
          {
            "fact": "tenant.cbeRegulated",
            "op": "eq",
            "value": true
          }
        ]
      },
      "obligation": "Material cloud outsourcing by a CBE-regulated entity needs prior CBE approval or notification.",
      "citations": [
        {
          "source": "CBE cloud/outsourcing instrument (to be identified from CBE publications)",
          "status": "verify"
        }
      ],
      "assessment": {
        "type": "customer-action"
      },
      "controls": [],
      "rationale": {
        "CUSTOMER_ACTION": "Obtain the CBE approval or make the notification before onboarding production data."
      }
    },
    {
      "id": "EG-CBE-DATA-LOCATION-ACCESS",
      "framework": "EG-CBE",
      "topic": "data-location",
      "appliesWhen": {
        "all": [
          {
            "fact": "tenant.jurisdictions",
            "op": "includes",
            "value": "EG"
          },
          {
            "fact": "tenant.cbeRegulated",
            "op": "eq",
            "value": true
          }
        ]
      },
      "obligation": "Keep regulated data where the CBE rules allow and guarantee the regulator's access to it.",
      "citations": [
        {
          "source": "CBE cloud/outsourcing instrument (to be identified from CBE publications)",
          "status": "verify"
        }
      ],
      "assessment": {
        "type": "residency",
        "country": "EG"
      },
      "controls": [
        "platform.region"
      ],
      "rationale": {
        "MET": "Hosted in Egypt.",
        "GAP": "Deployed in {deploymentRegions} ({deploymentCountries}); residency in {country} not met — multi-region deployment is out of the capstone scope."
      }
    },
    {
      "id": "EG-CBE-CYBER-FRAMEWORK-INCIDENT",
      "framework": "EG-CBE",
      "topic": "incident-reporting",
      "appliesWhen": {
        "all": [
          {
            "fact": "tenant.jurisdictions",
            "op": "includes",
            "value": "EG"
          },
          {
            "fact": "tenant.cbeRegulated",
            "op": "eq",
            "value": true
          }
        ]
      },
      "obligation": "Report cybersecurity incidents to the CBE within the deadlines of its cybersecurity framework.",
      "citations": [
        {
          "source": "CBE cybersecurity framework (to be identified from CBE publications)",
          "status": "verify"
        }
      ],
      "assessment": {
        "type": "platform-control",
        "metWhen": {
          "all": [
            {
              "fact": "platform.breachNotificationTooling",
              "op": "eq",
              "value": "sns-chatops"
            },
            {
              "fact": "platform.incidentAutomation",
              "op": "eq",
              "value": "enabled"
            }
          ]
        },
        "partialWhen": {
          "fact": "platform.breachNotificationTooling",
          "op": "eq",
          "value": "sns-chatops"
        }
      },
      "controls": [
        "soar.mttc",
        "soar.ir-report",
        "chatops.notify"
      ],
      "rationale": {
        "MET": "Detection, automated containment (MTTC target 60 s), SNS/ChatOps alerting and IR reports give the evidence needed for the notice. Sending the notice to the authority remains the controller's act.",
        "PARTIAL": "Alerting and IR reports exist, but automated containment is in dry-run or disabled: incident timelines depend on analysts. Sending the notice remains the controller's act.",
        "GAP": "No breach alerting path is configured."
      }
    },
    {
      "id": "EG-CBE-BANKING-SECRECY",
      "framework": "EG-CBE",
      "topic": "banking-secrecy",
      "appliesWhen": {
        "all": [
          {
            "fact": "tenant.jurisdictions",
            "op": "includes",
            "value": "EG"
          },
          {
            "fact": "tenant.cbeRegulated",
            "op": "eq",
            "value": true
          }
        ]
      },
      "obligation": "Customer account data is subject to banking secrecy.",
      "citations": [
        {
          "source": "Banking Law No. 194 of 2020",
          "status": "verify"
        }
      ],
      "assessment": {
        "type": "customer-action"
      },
      "controls": [
        "data.classification",
        "tenant.isolation"
      ],
      "rationale": {
        "CUSTOMER_ACTION": "Classify account data as restricted; CloudShield isolates tenants by partition key (not cryptographically, ADR-0002 §5)."
      }
    },
    {
      "id": "EU-GDPR-ART5-STORAGE-LIMITATION",
      "framework": "EU-GDPR",
      "topic": "storage-limitation",
      "appliesWhen": {
        "all": [
          {
            "fact": "tenant.jurisdictions",
            "op": "includes",
            "value": "EU"
          },
          {
            "fact": "tenant.processesPersonalData",
            "op": "eq",
            "value": true
          }
        ]
      },
      "obligation": "Keep personal data in identifiable form no longer than necessary for the purposes of processing.",
      "citations": [
        {
          "source": "Regulation (EU) 2016/679 (GDPR)",
          "article": "Art. 5(1)(e)",
          "status": "doc",
          "url": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
        }
      ],
      "assessment": {
        "type": "customer-action"
      },
      "controls": [
        "docs.tombstone"
      ],
      "rationale": {
        "CUSTOMER_ACTION": "Retention periods are the controller's decision; deletion is available per document."
      }
    },
    {
      "id": "EU-GDPR-ART6-LAWFUL-BASIS",
      "framework": "EU-GDPR",
      "topic": "lawful-basis",
      "appliesWhen": {
        "all": [
          {
            "fact": "tenant.jurisdictions",
            "op": "includes",
            "value": "EU"
          },
          {
            "fact": "tenant.processesPersonalData",
            "op": "eq",
            "value": true
          }
        ]
      },
      "obligation": "Process personal data only on one of the lawful bases of Art. 6(1).",
      "citations": [
        {
          "source": "Regulation (EU) 2016/679 (GDPR)",
          "article": "Art. 6",
          "status": "doc",
          "url": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
        }
      ],
      "assessment": {
        "type": "customer-action"
      },
      "controls": [],
      "rationale": {
        "CUSTOMER_ACTION": "The lawful basis is the controller's decision."
      }
    },
    {
      "id": "EU-GDPR-ART7-CONSENT",
      "framework": "EU-GDPR",
      "topic": "consent",
      "appliesWhen": {
        "all": [
          {
            "fact": "tenant.jurisdictions",
            "op": "includes",
            "value": "EU"
          },
          {
            "fact": "tenant.processesPersonalData",
            "op": "eq",
            "value": true
          }
        ]
      },
      "obligation": "Where processing relies on consent, be able to demonstrate it and let the data subject withdraw it as easily as it was given.",
      "citations": [
        {
          "source": "Regulation (EU) 2016/679 (GDPR)",
          "article": "Art. 7",
          "status": "doc",
          "url": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
        }
      ],
      "assessment": {
        "type": "customer-action"
      },
      "controls": [],
      "rationale": {
        "CUSTOMER_ACTION": "Consent records are kept by the controller, outside CloudShield."
      }
    },
    {
      "id": "EU-GDPR-ART17-ERASURE",
      "framework": "EU-GDPR",
      "topic": "erasure",
      "appliesWhen": {
        "all": [
          {
            "fact": "tenant.jurisdictions",
            "op": "includes",
            "value": "EU"
          },
          {
            "fact": "tenant.processesPersonalData",
            "op": "eq",
            "value": true
          }
        ]
      },
      "obligation": "Erase personal data without undue delay when an Art. 17 ground applies (answer within one month, Art. 12(3)).",
      "citations": [
        {
          "source": "Regulation (EU) 2016/679 (GDPR)",
          "article": "Art. 17",
          "status": "doc",
          "url": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
        },
        {
          "source": "Regulation (EU) 2016/679 (GDPR)",
          "article": "Art. 12(3)",
          "status": "doc",
          "url": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
        }
      ],
      "assessment": {
        "type": "platform-control",
        "metWhen": {
          "fact": "platform.erasureCompletesWithinDays",
          "op": "lte",
          "value": 30
        }
      },
      "controls": [
        "docs.tombstone",
        "s3.noncurrent-expiry"
      ],
      "rationale": {
        "MET": "Delete tombstones the document at once (metadata cleared) and places an S3 delete marker; non-current versions expire after 30 days, inside the one-month answer period. Backups (PITR, 35 days) are the residual.",
        "GAP": "Erasure takes longer than 30 days."
      }
    },
    {
      "id": "EU-GDPR-ART25-BY-DESIGN",
      "framework": "EU-GDPR",
      "topic": "privacy-by-design",
      "appliesWhen": {
        "all": [
          {
            "fact": "tenant.jurisdictions",
            "op": "includes",
            "value": "EU"
          },
          {
            "fact": "tenant.processesPersonalData",
            "op": "eq",
            "value": true
          }
        ]
      },
      "obligation": "Implement appropriate technical and organisational measures by design and by default.",
      "citations": [
        {
          "source": "Regulation (EU) 2016/679 (GDPR)",
          "article": "Art. 25",
          "status": "doc",
          "url": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
        }
      ],
      "assessment": {
        "type": "platform-control",
        "metWhen": {
          "all": [
            {
              "fact": "platform.encryptionAtRest",
              "op": "eq",
              "value": "kms-cmk"
            },
            {
              "fact": "platform.mfa",
              "op": "eq",
              "value": "totp-required"
            }
          ]
        }
      },
      "controls": [
        "kms.cmk",
        "cognito.mfa",
        "tenant.isolation"
      ],
      "rationale": {
        "MET": "Customer-managed KMS keys, mandatory TOTP MFA, deny-by-default RBAC and per-tenant partitioning.",
        "GAP": "Encryption or MFA defaults are weaker than required."
      }
    },
    {
      "id": "EU-GDPR-ART28-PROCESSOR-CONTRACT",
      "framework": "EU-GDPR",
      "topic": "processor-contract",
      "appliesWhen": {
        "all": [
          {
            "fact": "tenant.jurisdictions",
            "op": "includes",
            "value": "EU"
          },
          {
            "fact": "tenant.processesPersonalData",
            "op": "eq",
            "value": true
          }
        ]
      },
      "obligation": "Processing by a processor is governed by a contract with the Art. 28(3) content; it may be in electronic form (Art. 28(9)).",
      "citations": [
        {
          "source": "Regulation (EU) 2016/679 (GDPR)",
          "article": "Art. 28(3)",
          "status": "doc",
          "url": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
        },
        {
          "source": "Regulation (EU) 2016/679 (GDPR)",

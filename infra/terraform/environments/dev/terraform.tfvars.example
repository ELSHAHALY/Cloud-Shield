# Copy to terraform.tfvars (git-ignored). Every value has a safe default;
# override only what you need.
project_name = "cloudshield"
environment  = "dev"
aws_region   = "us-east-1"

# ---- S1 ----
enable_interface_endpoints = false
container_image            = null # e.g. "<acct>.dkr.ecr.us-east-1.amazonaws.com/cloudshield-dev/docs-api@sha256:<64 hex>"
enable_report_worker       = false
allow_worker_lab_scan      = false
enable_edge                = false # CloudFront + WAF x2 (~US$20/month); us-east-1 only
waf_rate_limit             = 300   # site-wide 429 only
waf_api_rate_limit         = 200   # /api/* only; the PB-05 feed
github_oidc_provider_arn   = null # bootstrap output github_oidc_provider_arn -> CI ECR push role
soar_scope_app_service     = false
enable_decoy_route         = false # Phase E: unauthenticated /api/admin* decoy (static 403); needs enable_edge + container_image

# ---- S2 ----
cognito_mfa_configuration   = "ON"
cognito_deletion_protection = false

# ---- S3 ----
log_archive_force_destroy    = true
log_archive_object_lock_days = 0
soar_notification_emails     = ["analyst@example.com"]
soar_dry_run                 = true
soar_min_severity            = 7
soar_playbook_package        = null # { s3_bucket = "...", s3_key = "soar/playbooks-<sha>.zip" }
enable_decoy_publisher       = false # Phase E: decoy hits -> notify-only edge findings; needs enable_edge + container_image + soar_playbook_package
chatops_webhook_param_name   = "" # e.g. "/cloudshield-dev/soar/chatops_webhook" (SecureString; see docs/runbooks/chatops-setup.md)
